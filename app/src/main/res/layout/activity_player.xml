<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <com.linkinlt.tubelite.AspectFrame
        android:id="@+id/aspect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.linkinlt.tubelite.AspectFrame>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/red" />

    <TextView
        android:id="@+id/msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/badge"
        android:gravity="center"
        android:maxWidth="560dp"
        android:padding="16dp"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Thanh điều khiển kiểu mkodi -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/overlay_grad"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="60dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/vTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tPos"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:focusable="true"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@drawable/seek_thumb" />
            <TextView
                android:id="@+id/tDur"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="0:00"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ctrls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/bPrev" style="@style/CtrlBtn" android:drawableTop="@drawable/ic_prev" android:text="Trước" />
            <TextView android:id="@+id/bRew" style="@style/CtrlBtn" android:drawableTop="@drawable/ic_rew" android:text="Lùi 10s" />
            <TextView android:id="@+id/bPlay" style="@style/CtrlBtn" android:drawableTop="@drawable/ic_pause" android:text="Tạm dừng" />
            <TextView android:id="@+id/bFwd" style="@style/CtrlBtn" android:drawableTop="@drawable/ic_fwd" android:text="Tới 10s" />
            <TextView android:id="@+id/bNext" style="@style/CtrlBtn" android:drawableTop="@drawable/ic_next" android:text="Tiếp" />
            <TextView android:id="@+id/bQuality" style="@style/CtrlBtn" android:drawableTop="@drawable/ic_hd" android:text="720p" />
            <TextView android:id="@+id/bSpeed" style="@style/CtrlBtn" android:drawableTop="@drawable/ic_speed" android:text="Tốc độ 1x" />
        </LinearLayout>

        <TextView
            android:id="@+id/relTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Video liên quan  ▼"
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:id="@+id/relScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/related"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
